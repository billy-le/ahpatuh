{
  "extends": "../../tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx", "../booking-widget/dist/ahpatuh.min.js"],
  "references": [
    {
      "path": "../../packages/backend"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/utils"
    },
    {
      "path": "../booking-widget"
    }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ahpatuh/booking-widget": ["../booking-widget/dist/ahpatuh.min.js"],
      "@ahpatuh/convex/*": ["../../packages/backend/convex/*"],
      "@ahpatuh/ui": ["../../packages/ui"],
      "@ahpatuh/utils": ["../../packages/utils"],
      "@/lib/*": ["./src/lib/*"],
      "@/components/*": ["./src/components/*"]
    }
  }
}
